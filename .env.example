# ==========================================================================
# NOVA Assistant - Environment configuration
# Copy this file to ".env" and adjust values. docker-compose reads ".env".
# ==========================================================================

# --- PostgreSQL ---
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_secret
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=nova_redis
REDIS_PORT=6379

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
# Generate a strong secret, e.g.:  openssl rand -hex 48
JWT_SECRET=change_me_to_a_long_random_64_char_secret_value_please_now_0000
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- AI provider ---
# "openai" -> uses OpenAI when OPENAI_API_KEY is set, otherwise auto-falls back to mock.
# "mock"   -> always uses the deterministic offline brain (no key required).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local brain (OpenJarvis / Ollama) — private, offline inference ---
# NOVA offers a "Local (OpenJarvis)" engine in the chat model dropdown.
# Point it at any OpenAI-compatible server. See docs/OPENJARVIS.md.
NOVA_AI_LOCAL_ENABLED=true
NOVA_AI_LOCAL_BASE_URL=http://localhost:8000/v1   # Ollama: http://localhost:11434/v1
NOVA_AI_LOCAL_MODEL=                               # empty = OpenJarvis auto-selects
NOVA_AI_LOCAL_API_KEY=local
NOVA_AI_LOCAL_LABEL=Local (OpenJarvis)

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Models (swap here if the provider retires one; no code change needed) ---
NOVA_AI_MODELS_FAST=openai/gpt-oss-20b
NOVA_AI_MODELS_STRONG=openai/gpt-oss-120b
NOVA_AI_MODELS_CATALOG=openai/gpt-oss-120b|GPT-OSS 120B (potente),openai/gpt-oss-20b|GPT-OSS 20B (rápido),qwen/qwen3.8-27b|Qwen 3.8 27B
NOVA_AI_MODELS_WHISPER=whisper-large-v3

# --- Hardening ---
NOVA_AUTH_REGISTRATION_ENABLED=false   # public sign-up off (personal assistant)
NOVA_RATE_LIMIT_ENABLED=true
NOVA_RATE_LIMIT_AUTH_PER_MINUTE=8      # login/refresh attempts per IP per minute
NOVA_RATE_LIMIT_AI_PER_MINUTE=30       # chat/voice/SOC calls per IP per minute

# --- Proactividad ---
NOVA_TIMEZONE=America/Bogota            # hora local que NOVA usa al hablar y agendar
NOVA_SOC_KEV_WATCH_ENABLED=true         # alertas de CVEs explotados (catálogo CISA KEV)
NOVA_SOC_KEV_WATCH_VENDORS=Fortinet,Microsoft,Cisco,Palo Alto,Ivanti,Citrix,VMware,Apache,Linux,Google,Apple,Oracle,SonicWall,Juniper,Atlassian

# --- Google Gemini (plan gratuito; https://aistudio.google.com/apikey) ---
# Activa: respaldo cuando Groq llega al límite, análisis de imágenes, voz neuronal,
# cuadernos (modo NotebookLM) y Gemini Live en el HUD. Vacío = todo desactivado.
NOVA_AI_GEMINI_API_KEY=
NOVA_AI_GEMINI_CHAT_MODEL=gemini-3.8-flash
NOVA_AI_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
NOVA_AI_GEMINI_LIVE_MODEL=gemini-3.8-live
NOVA_AI_GEMINI_FALLBACK=true    # el chat salta a Gemini si Groq falla (el SOC nunca usa Gemini)
NOVA_AI_GEMINI_TTS=true
NOVA_AI_GEMINI_LIVE=true
