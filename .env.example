# ==========================================================================
# NOVA Assistant - Environment configuration
# Copy this file to ".env" and adjust values. docker-compose reads ".env".
# ==========================================================================

# --- PostgreSQL ---
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_secret
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=nova_redis
REDIS_PORT=6379

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
# Generate a strong secret, e.g.:  openssl rand -hex 48
JWT_SECRET=change_me_to_a_long_random_64_char_secret_value_please_now_0000
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- AI provider ---
# "openai" -> uses OpenAI when OPENAI_API_KEY is set, otherwise auto-falls back to mock.
# "mock"   -> always uses the deterministic offline brain (no key required).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local brain (OpenJarvis / Ollama) — private, offline inference ---
# NOVA offers a "Local (OpenJarvis)" engine in the chat model dropdown.
# Point it at any OpenAI-compatible server. See docs/OPENJARVIS.md.
NOVA_AI_LOCAL_ENABLED=true
NOVA_AI_LOCAL_BASE_URL=http://localhost:8000/v1   # Ollama: http://localhost:11434/v1
NOVA_AI_LOCAL_MODEL=                               # empty = OpenJarvis auto-selects
NOVA_AI_LOCAL_API_KEY=local
NOVA_AI_LOCAL_LABEL=Local (OpenJarvis)

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
